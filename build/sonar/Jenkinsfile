pipeline {
  agent any

  options {
    buildDiscarder(logRotator(numToKeepStr: '30'))
    disableConcurrentBuilds()
  }

  triggers {
    cron '@midnight'
  }

  stages {
    stage('build') {
      when {
        branch 'master'
      }
      steps {
        script {          
          docker.build('maven', '-f build/Dockerfile.maven .').inside("") {
            withCredentials([string(credentialsId: 'sonar.ivyteam.io', variable: 'token')]) {
              maven cmd: 'package org.sonarsource.scanner.maven:sonar-maven-plugin:5.7.0.6970:sonar ' +
                        '-Dsonar.host.url=https://sonar.ivyteam.io ' +
                        '-Dsonar.projectKey=engine-cockpit ' +
                        '-Dsonar.projectName=engine-cockpit ' +
                        "-Dsonar.token=${token}"
            }
          }
          recordIssues tools: [mavenConsole()], qualityGates: [[threshold: 1, type: 'TOTAL']], filters: [
            excludeMessage('Use of preview features have been detected during analysis. Enable DEBUG mode to see them.*'),
            excludeMessage('Unresolved imports/types have been detected during analysis. Enable DEBUG mode to see them.*'),
            excludeMessage('JAR will be empty - no content was marked for inclusion!*'),
            excludeMessage('Invalid character encountered in file*'),
          ]
        }
      }
    }
  }
}
