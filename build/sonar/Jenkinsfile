pipeline {
  agent any

  options {
    buildDiscarder(logRotator(numToKeepStr: '30'))
    disableConcurrentBuilds()
  }

  triggers {
    cron '@midnight'
  }

  stages {
    stage('build') {
      when {
        branch 'master'
      }
      steps {
        script {          
          docker.build('maven', '-f build/Dockerfile.maven .').inside("") {
            sonar projectName: 'engine-cockpit', mvnArgs: "-Dsonar.src.exclusions=**/src_generated/** -Dsonar.test.exclusions=**/*.p12"
          }
        }
      }
    }
  }
}
